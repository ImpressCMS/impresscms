{
	"name": "impresscms/impresscms",
	"description": "ImpressCMS - A dynamic and user-friendly Content Management System (Symfony host)",
	"type": "project",
	"license": "GPL-2.0-only",
	"homepage": "https://www.impresscms.org/",
	"require": {
		"php": ">=8.2 <8.5",
		"ext-gd": "*",
		"ext-json": "*",
		"ext-mbstring": "*",
		"ext-mysqli": "*",
		"ext-pcre": "*",
		"ext-pdo": "*",
		"ext-session": "*",
		"ext-xml": "*",
		"ext-zlib": "*",
		"composer/composer": "^2.9",
		"ezyang/htmlpurifier": "^4.19",
		"simplepie/simplepie": "^1.9",
		"smottt/wideimage": "^1.1.4"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5",
		"symfony/browser-kit": "7.4.*",
		"symfony/http-client": "7.4.*",
		"symfony/mime": "7.4.*",
		"symfony/phpunit-bridge": "7.4.*",
		"symfony/process": "7.4.*"
	},
	"autoload": {
		"psr-4": {
			"Icms\\": "htdocs/libraries/Icms/"
		},
		"classmap": [
			"htdocs/libraries/icms.php"
		],
		"files": [
			"htdocs/libraries/Autoloader.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"App\\Tests\\": "tests/",
			"Icms\\Tests\\": "htdocs/tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.2.0"
		},
		"sort-packages": true,
		"allow-plugins": {
			"*": false
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
