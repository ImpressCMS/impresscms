#!/usr/bin/env php
<?php
/**
 * Build the release package: a zip whose contents go straight into a hosting
 * account's web root (public_html, www, ...).
 *
 * The package holds htdocs/ of a committed revision, with the contents of
 * htdocs/ in the root of the zip.
 *
 * With --from, the package only holds the files that were added or modified
 * between --from and --to; files deleted in that range are listed in
 * DELETED-FILES.txt in the root of the zip.
 *
 * Usage: bin/build-package [--from=<git ref>] [--to=<git ref>] [--output=<zip>]
 *   --from      base revision; only files changed since it are packaged (default: full package)
 *   --to        revision to package (default HEAD); uncommitted changes are never included
 *   --ref       alias of --to
 *   --output    the zip to write (default var/dist/<version>-<commit>.zip, or
 *               <version>-<from>-to-<commit>.zip with --from)
 */

declare(strict_types=1);

$root = str_replace('\\', '/', dirname(__DIR__));
$ref = 'HEAD';
$from = null;
$output = null;

foreach (array_slice($argv, 1) as $arg) {
    if (str_starts_with($arg, '--ref=')) {
        $ref = substr($arg, 6);
    } elseif (str_starts_with($arg, '--to=')) {
        $ref = substr($arg, 5);
    } elseif (str_starts_with($arg, '--from=')) {
        $from = substr($arg, 7);
    } elseif (str_starts_with($arg, '--output=')) {
        $output = str_replace('\\', '/', substr($arg, 9));
    } else {
        fwrite(STDERR, "Unknown argument {$arg}\n");
        exit(2);
    }
}

if (!class_exists(ZipArchive::class)) {
    fwrite(STDERR, "The zip extension is required.\n");
    exit(1);
}

$run = static function (string $command) use ($root): string {
    $lines = [];
    exec('git -C ' . escapeshellarg($root) . ' ' . $command, $lines, $status);
    if ($status !== 0) {
        fwrite(STDERR, "git {$command} failed.\n");
        exit(1);
    }

    return trim(implode("\n", $lines));
};

$remove = static function (string $path) use (&$remove): void {
    if (is_dir($path) && !is_link($path)) {
        foreach (new FilesystemIterator($path, FilesystemIterator::SKIP_DOTS) as $item) {
            $remove($item->getPathname());
        }
        rmdir($path);
    } elseif (file_exists($path) || is_link($path)) {
        unlink($path);
    }
};

$commit = $run('rev-parse --short ' . escapeshellarg($ref . '^{commit}'));

$changed = null;
$deleted = [];
$fromCommit = null;

if ($from !== null) {
    $fromCommit = $run('rev-parse --short ' . escapeshellarg($from . '^{commit}'));
    $changed = [];

    $diff = $run('-c core.quotepath=false diff --name-status --no-renames ' . escapeshellarg($fromCommit) . ' ' . escapeshellarg($commit) . ' -- htdocs');
    foreach ($diff === '' ? [] : explode("\n", $diff) as $line) {
        [$status, $path] = explode("\t", $line, 2);
        $path = substr($path, strlen('htdocs/'));

        if ($status === 'D') {
            $deleted[] = $path;
            continue;
        }

        $changed[$path] = true;
    }
}

$work = "{$root}/var/package";
$remove($work);
mkdir($work, 0777, true);

$archive = "{$work}/source.zip";
$run('-c core.autocrlf=false -c core.eol=lf archive --format=zip -o ' . escapeshellarg($archive) . ' ' . escapeshellarg($commit) . ' htdocs');

$source = "{$work}/source";
$zip = new ZipArchive();
if ($zip->open($archive) !== true || !$zip->extractTo($source)) {
    fwrite(STDERR, "Could not extract {$archive}\n");
    exit(1);
}
$zip->close();
unlink($archive);

$webRoot = "{$source}/htdocs";

$version = 'impresscms';
$versionFile = (string) file_get_contents("{$webRoot}/include/version.php");
if (preg_match("/define\\('ICMS_VERSION_NAME',\\s*'([^']+)'\\)/", $versionFile, $matches)) {
    $version = strtolower(trim((string) preg_replace('/[^A-Za-z0-9.]+/', '-', $matches[1]), '-'));
}

$output ??= $fromCommit === null ?
    "{$root}/var/dist/{$version}-{$commit}.zip" :
    "{$root}/var/dist/{$version}-{$fromCommit}-to-{$commit}.zip";
@mkdir(dirname($output), 0777, true);
@unlink($output);

// Development only; relative to htdocs
$excluded = ['tests'];

$zip = new ZipArchive();
if ($zip->open($output, ZipArchive::CREATE | ZipArchive::EXCL) !== true) {
    fwrite(STDERR, "Could not create {$output}\n");
    exit(1);
}

$items = new RecursiveIteratorIterator(
    new RecursiveCallbackFilterIterator(
        new RecursiveDirectoryIterator($webRoot, FilesystemIterator::SKIP_DOTS),
        static function (SplFileInfo $item) use ($webRoot, $excluded): bool {
            $relative = substr(str_replace('\\', '/', $item->getPathname()), strlen($webRoot) + 1);

            return !in_array($relative, $excluded, true);
        },
    ),
    RecursiveIteratorIterator::SELF_FIRST,
);

$files = 0;
foreach ($items as $item) {
    $name = substr(str_replace('\\', '/', $item->getPathname()), strlen($webRoot) + 1);

    if ($changed !== null) {
        if ($item->isDir() || !isset($changed[$name])) {
            continue;
        }
    }

    if ($item->isDir()) {
        $zip->addEmptyDir($name);
        $zip->setExternalAttributesName("{$name}/", ZipArchive::OPSYS_UNIX, 040755 << 16);
        continue;
    }

    $zip->addFile($item->getPathname(), $name);
    $zip->setExternalAttributesName($name, ZipArchive::OPSYS_UNIX, 0100644 << 16);
    $files++;
}

if ($changed !== null && $files === 0) {
    $zip->close();
    $remove($work);
    fwrite(STDERR, "No files changed between {$fromCommit} and {$commit}; no package written.\n");
    exit(1);
}

if ($deleted !== []) {
    sort($deleted);
    $zip->addFromString('DELETED-FILES.txt', implode("\n", $deleted) . "\n");
}

if (!$zip->close()) {
    fwrite(STDERR, "Could not write {$output}\n");
    exit(1);
}

$remove($work);

if ($changed === null) {
    $check = new ZipArchive();
    $check->open($output);
    foreach (['index.php', 'mainfile.php', 'include/version.php', 'install/index.php'] as $required) {
        if ($check->locateName($required) === false) {
            fwrite(STDERR, "The package is incomplete: {$required} is missing.\n");
            exit(1);
        }
    }
    $check->close();
}

if ($deleted !== []) {
    printf("Deleted between %s and %s (remove manually, listed in DELETED-FILES.txt):\n  %s\n", $fromCommit, $commit, implode("\n  ", $deleted));
}

printf("Package ready: %s (%d files, %.1f MB)\n", $output, $files, filesize($output) / 1048576);
