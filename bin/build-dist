#!/usr/bin/env php
<?php
/**
 * Assemble the host's staging directory for a release package.
 *
 * Copies the host (host.php, composer.json, composer.lock, .env, src/, config/,
 * templates/, bin/console) into htdocs/trust_dist/ and installs its
 * dependencies there without development packages. The installer and the
 * system module update copy this directory into the site's trust path (see
 * icms_core_Filesystem::installTrustDistribution()); until then legacy loads
 * its classes from trust_dist/vendor. Composer paths are relative, so the tree
 * works in place and after copying.
 *
 * Usage: bin/build-dist [--target=<dir>] [--composer=<command>]
 *   --target    where to build (default htdocs/trust_dist); replaced if it exists
 *   --composer  the Composer command (default: COMPOSER_BINARY or `composer`)
 */

declare(strict_types=1);

$root = str_replace('\\', '/', dirname(__DIR__));
$target = $root . '/htdocs/trust_dist';
$composer = getenv('COMPOSER_BINARY') ?: 'composer';
foreach (array_slice($argv, 1) as $arg) {
    if (str_starts_with($arg, '--target=')) {
        $target = rtrim(str_replace('\\', '/', substr($arg, 9)), '/');
    } elseif (str_starts_with($arg, '--composer=')) {
        $composer = substr($arg, 11);
    } else {
        fwrite(STDERR, "Unknown argument {$arg}\n");
        exit(2);
    }
}

$remove = static function (string $path) use (&$remove): void {
    if (is_dir($path) && !is_link($path)) {
        foreach (new FilesystemIterator($path, FilesystemIterator::SKIP_DOTS) as $item) {
            $remove($item->getPathname());
        }
        rmdir($path);
    } elseif (file_exists($path) || is_link($path)) {
        unlink($path);
    }
};
$copy = static function (string $from, string $to) use (&$copy): void {
    if (is_dir($from)) {
        @mkdir($to, 0777, true);
        foreach (new FilesystemIterator($from, FilesystemIterator::SKIP_DOTS) as $item) {
            $copy($item->getPathname(), $to . '/' . $item->getFilename());
        }
    } else {
        @mkdir(dirname($to), 0777, true);
        copy($from, $to);
    }
};

$remove($target);
mkdir($target, 0777, true);

foreach (['host.php', 'composer.json', 'composer.lock', '.env', 'src', 'config', 'templates', 'bin/console'] as $entry) {
    if (!file_exists("{$root}/{$entry}")) {
        fwrite(STDERR, "Missing {$root}/{$entry}\n");
        exit(1);
    }
    $copy("{$root}/{$entry}", "{$target}/{$entry}");
}
// generated by the kernel in debug mode
@unlink("{$target}/config/reference.php");

// Second line of defence on Apache; nginx and Caddy deny it in their configuration.
file_put_contents("{$target}/.htaccess", "# Never served: installed into the trust path by the installer or the system module update.\nRequire all denied\n");

$command = sprintf(
    '%s install --no-dev --classmap-authoritative --no-interaction --no-progress --working-dir=%s',
    $composer,
    escapeshellarg($target),
);
echo "> {$command}\n";
passthru($command, $status);
if ($status !== 0) {
    fwrite(STDERR, "Composer failed.\n");
    exit($status);
}

foreach (['host.php', 'vendor/autoload.php'] as $required) {
    if (!is_file("{$target}/{$required}")) {
        fwrite(STDERR, "The build is incomplete: {$target}/{$required} is missing.\n");
        exit(1);
    }
}

echo "Host staging directory ready: {$target}\n";
