parameters:
    level: 6
    paths:
        - src
        - htdocs/libraries/Icms/Kernel
    bootstrapFiles:
        # constants ImpressCMS defines at runtime
        - phpstan-bootstrap.php
        # the Icms library and its legacy names (not in composer.json, see host.php)
        - htdocs/libraries/Autoloader.php
        # language constants (the English files; every language defines the same)
        - htdocs/language/english/global.php
        - htdocs/language/english/core.php
        - htdocs/modules/system/language/english/common.php
        - htdocs/modules/system/language/english/admin.php
        - htdocs/modules/system/language/english/admin/mimetype.php
    scanDirectories:
        - htdocs/libraries/Icms
    scanFiles:
        - htdocs/include/functions.php
        - htdocs/include/cp_functions.php
        - htdocs/include/host.php
        - htdocs/libraries/icms.php
    # the legacy library's PHPDoc types are not reliable (icms::$user is null
    # for anonymous visitors, for example)
    treatPhpDocTypesAsCertain: false
    tmpDir: var/cache/phpstan
    # defined per installation (mainfile.php) or per language
    dynamicConstantNames:
        - ICMS_ROOT_PATH
        - ICMS_TRUST_PATH
        - ICMS_INCLUDE_PATH
        - ICMS_LIBRARIES_PATH
        - ICMS_GROUP_ADMIN
        - ICMS_GROUP_USERS
        - ICMS_GROUP_ANONYMOUS
        - _INTL_LOCALE
        - _ADM_USE_RTL
        - ICMS_URL
        - _GLOBAL_LEFT
