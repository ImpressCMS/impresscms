includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - bootstrap
        - routes
        - config
        - public
        - htdocs/libraries/Icms/Kernel
    bootstrapFiles:
        # constants ImpressCMS defines at runtime
        - phpstan-bootstrap.php
    scanFiles:
        - htdocs/include/functions.php
    # the legacy library's PHPDoc types are not reliable (icms::$user is null
    # for anonymous visitors, for example)
    treatPhpDocTypesAsCertain: false
    tmpDir: var/cache/phpstan
    # defined per installation (mainfile.php) or per language
    dynamicConstantNames:
        - ICMS_ROOT_PATH
        - ICMS_TRUST_PATH
        - ICMS_INCLUDE_PATH
        - ICMS_LIBRARIES_PATH
        - ICMS_GROUP_ADMIN
        - ICMS_GROUP_USERS
        - ICMS_GROUP_ANONYMOUS
        - _INTL_LOCALE
        - _ADM_USE_RTL
        - XOOPS_DB_HOST
        - XOOPS_DB_NAME
        - XOOPS_DB_USER
        - XOOPS_DB_PASS
        - XOOPS_DB_PREFIX
        - XOOPS_DB_CHARSET
        - XOOPS_DB_PCONNECT
